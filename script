print("STARTING CALCULTOR")
def add(x,y):
    return x + y
def subtract(x,y):
    return x - y
def multiply(x,y):
    return x*y
def divide(x,y):
    return x/y

answer = None
def menu():
    print("1. Add")
    print("2. Subtract")
    print("3. Multiply")
    print("4. Divide")
    print("5. Quit")
    print("6. Previous answer")
    try:
        choice = int(input("What function would you like to use?: "))
        return choice
    except: 
        print("That is not a number.")
        return None
while True:
    choice = menu()
    if choice is None:
        continue
    if choice < 1 or choice > 6:
        print("Invalid option")
    elif choice == 5:
        break
    elif choice == 6: 
        if answer is None:
            print("No previous answer.")
        else:
            print(answer)
    else:
        try:
            x = float(input("Enter your first number: "))
            y = float(input("Enter your second number: "))
        except: 
            print("That is not a number.")
            continue
        if choice == 1:
            answer = add(x,y)
            print(answer)
        elif choice == 2:
            answer = subtract(x,y)
            print(answer)
        elif choice == 3:
            answer = multiply(x,y)
            print(answer)
        elif choice == 4:
            if y == 0:
                print("Cannot divide by zero!")
            else:
                answer = divide(x,y)
                print(answer)
